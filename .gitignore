# =====================================================================
#   Single root .gitignore for the monorepo: covers rag-core, backend,
#   and frontend in one place.
# =====================================================================

# --- Python ----------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/

# Virtual environments
.venv/
venv/
env/

# Editable-install metadata
build/
*.egg

# --- Node / Vite -----------------------------------------------------
node_modules/
dist/
dist-ssr/
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# --- Persistent data / runtime artifacts -----------------------------
# The vector store DB and uploaded user files are generated at runtime
# and live under rag-core/data/ — never tracked.
rag-core/data/chroma/
rag-core/data/uploads/

# --- Secrets ---------------------------------------------------------
.env
.env.*
!.env.example

# --- IDE / OS --------------------------------------------------------
.vscode/
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
.vercel
